generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  user_id       Int      @id @default(autoincrement())
  first_name    String
  full_name     String?
  email         String   @unique
  password_hash String?
  citizenship   String?
  postal_code   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  // keep your existing relations here
  academic_profile UserAcademicProfile?
  preferences       UserPreference[]
  interest_preference      UserInterestPreference?
  course_finder_preference UserCourseFinderPreference?
  ai_assessment_usage AiAssessmentDailyUsage[]

  @@map("users")
}
model UserAcademicProfile {
  academic_profile_id Int      @id @default(autoincrement())
  user_id             Int      @unique
  qualification_type  String
  current_gpa         Decimal? @db.Decimal(3, 2)
  projected_gpa       Decimal? @db.Decimal(3, 2)
  rank_points         Decimal? @db.Decimal(5, 2)
  uas_70              Decimal? @db.Decimal(5, 2)
  diploma_name        String?
  institution_name    String?
  graduation_year     Int?
  english_grade       String?
  math_grade          String?
  computing_grade     String?
  created_at          DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_academic_profiles")
}

model UserPreference {
  preference_id               Int      @id @default(autoincrement())
  user_id                     Int
  preferred_fields            Json?
  preferred_universities      Json?
  prioritise_salary           Int?
  prioritise_interest_fit     Int?
  prioritise_flexibility      Int?
  prioritise_admission_chance Int?
  prioritise_prestige         Int?
  wants_broad_degree          Boolean?
  created_at                  DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_preferences")
}

model University {
  university_id   Int      @id @default(autoincrement())
  university_name String   @unique
  short_name      String?  @unique
  country         String?
  postal_code     String?  @unique
  website_url     String?
  created_at      DateTime @default(now())

  courses Course[]

  @@map("universities")
}

model Course {
  course_id        Int      @id @default(autoincrement())
  university_id    Int
  course_name      String
  school           String?
  duration_years   Decimal? @db.Decimal(4, 1)
  career_prospects String?
  created_at       DateTime @default(now())

  university        University                @relation(fields: [university_id], references: [university_id], onDelete: Cascade)
  admissions        CourseAdmissionsProfile[]
  outcomes          CourseOutcome[]
  related_interests CourseRelatedInterest[]

  @@unique([university_id, course_name])
  @@map("courses")
}

model CourseAdmissionsProfile {
  admission_profile_id    Int      @id @default(autoincrement())
  course_id               Int
  min_gpa                 Decimal? @db.Decimal(3, 2)
  tenth_percentile_grades String?
  tenth_percentile_rp     Decimal? @db.Decimal(5, 2)
  tenth_percentile_uas_70 Decimal? @db.Decimal(5, 2)
  score_system            String?
  required_subjects       Json?
  notes                   String?
  intake_size             Int?
  demand_score            Decimal? @db.Decimal(5, 2)
  competitiveness_band    String?
  year_recorded           Int
  source_type             String?
  last_updated            DateTime @updatedAt

  course       Course                       @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  band_metrics CourseAdmissionsBandMetric[]

  @@unique([course_id, year_recorded])
  @@index([year_recorded])
  @@map("course_admissions_profiles")
}

model CourseAdmissionsBandMetric {
  band_metric_id       Int      @id @default(autoincrement())
  admission_profile_id Int
  university_code      String
  qualification_type   String
  metric_type          String
  scope_type           String?
  band_label           String
  band_min             Decimal? @db.Decimal(5, 2)
  band_max             Decimal? @db.Decimal(5, 2)
  band_min_uas_70      Decimal? @db.Decimal(5, 2)
  band_max_uas_70      Decimal? @db.Decimal(5, 2)
  percentage_value     Decimal? @db.Decimal(5, 2)
  band_score_system    String?
  display_order        Int?
  source_note          String?
  created_at           DateTime @default(now())

  admission_profile CourseAdmissionsProfile @relation(fields: [admission_profile_id], references: [admission_profile_id], onDelete: Cascade)

  @@index([admission_profile_id])
  @@index([university_code, qualification_type, metric_type])
  @@index([band_score_system])
  @@map("course_admissions_band_metrics")
}

model CourseOutcome {
  outcome_id              Int      @id @default(autoincrement())
  course_id               Int
  basic_monthly_median    Decimal? @db.Decimal(10, 2)
  gross_monthly_median    Decimal? @db.Decimal(10, 2)
  employment_rate_overall Decimal? @db.Decimal(5, 2)
  employment_rate_ft_perm Decimal? @db.Decimal(5, 2)
  career_prospects_score  Decimal? @db.Decimal(5, 2)
  source_year             Int
  source_type             String?
  created_at              DateTime @default(now())

  course Course @relation(fields: [course_id], references: [course_id], onDelete: Cascade)

  @@unique([course_id, source_year])
  @@map("course_outcomes")
}

model InterestGroup {
  interest_group_id Int      @id @default(autoincrement())
  interest_name     String   @unique
  description       String?
  created_at        DateTime @default(now())

  related_courses CourseRelatedInterest[]

  @@map("interest_groups")
}

model CourseRelatedInterest {
  course_related_interest_id Int      @id @default(autoincrement())
  course_id                  Int
  interest_group_id          Int
  relevance_score            Int
  source_type                String?
  source_note                String?
  created_at                 DateTime @default(now())
  last_updated               DateTime @updatedAt

  course         Course        @relation(fields: [course_id], references: [course_id], onDelete: Cascade)
  interest_group InterestGroup @relation(fields: [interest_group_id], references: [interest_group_id], onDelete: Cascade)

  @@unique([course_id, interest_group_id])
  @@index([course_id])
  @@index([interest_group_id])
  @@index([relevance_score])
  @@map("course_related_interests")
}

model CompareAiAssessment {
  assessment_id      Int      @id @default(autoincrement())
  user_id            Int
  left_course_id     Int
  right_course_id    Int
  input_hash         String   @unique
  request_payload    Json
  assessment_result  Json
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

model AiAssessmentDailyUsage {
  usage_id   Int      @id @default(autoincrement())
  user_id    Int
  usage_date DateTime @db.Date
  used_count Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, usage_date])
  @@index([usage_date])
  @@map("ai_assessment_daily_usage")
}

model UserInterestPreference {
  interest_preference_id Int      @id @default(autoincrement())
  user_id                Int      @unique
  wanted_interests       Json?
  unwanted_interests     Json?
  created_at             DateTime @default(now())
  updated_at             DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_interest_preferences")
}

model UserCourseFinderPreference {
  finder_preference_id   Int      @id @default(autoincrement())
  user_id                Int      @unique
  gpa_boost              String?  @default("0")
  band_min_percentage    String?  @default("80")
  selected_universities  Json?
  only_wanted            Boolean  @default(false)
  exclude_unwanted       Boolean  @default(false)
  course_keyword         String?  @default("")
  active_uni             String?  @default("All")
  priority_space         Json?
  created_at             DateTime @default(now())
  updated_at             DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("user_course_finder_preferences")
}
